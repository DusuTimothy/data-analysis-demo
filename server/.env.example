# Runtime environment: development | test | production
NODE_ENV=development
PORT=4000

# Read-only application role. It must only have SELECT on the analytics view.
DATABASE_URL=postgresql://plateau_campaign_app:REPLACE_ME@127.0.0.1:5432/plateau_campaign

# Used only by `npm run db:setup` and `npm run seed`. Never used by the API.
# In production, remove this line entirely.
SEED_DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:5432/plateau_campaign

# Campaign identity shown in the dashboard header.
CANDIDATE_NAME=REPLACE_WITH_CANDIDATE_NAME
PARTY_NAME=APC
SENATORIAL_DISTRICT=Plateau
ELECTION_YEAR=2027

# Official LGA composition of the senatorial district. Required. The example
# values below are a DEMO PLACEHOLDER, not an authoritative list.
PLATEAU_SENATORIAL_LGAS=Bokkos,Kanam,Kanke,Mangu,Pankshin

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production database TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Set true only for local debugging. Query text is never logged.
DB_LOGGING=false
TRUST_PROXY=false
LOG_LEVEL=info
